        <mxCell id="c39" value="&lt;b&gt;Groupes de sécurité : règles entrantes&lt;/b&gt; (tout le reste est refusé)&lt;br&gt;&lt;b&gt;sg-restitution&lt;/b&gt; : 443/tcp ← 0.0.0.0/0 · 22 ← sg-orchestration&lt;br&gt;&lt;b&gt;sg-orchestration&lt;/b&gt; : 3000 ← sg-restitution · 9100 ← sg-supervision&lt;br&gt;&lt;b&gt;sg-supervision&lt;/b&gt; : 3000 ← sg-restitution · 3100 ← tout le VPC (Alloy) · 22 ← sg-orchestration&lt;br&gt;&lt;b&gt;sg-depot&lt;/b&gt; : 22/tcp (SFTP) et 443/tcp ← 0.0.0.0/0 · 9100 ← sg-supervision · SSH d'administration sur l'interface privée ← sg-orchestration&lt;br&gt;&lt;b&gt;sg-clickhouse&lt;/b&gt; : 9440 ← sg-orchestration · 8443 ← sg-restitution · 9100, 9363 ← sg-supervision · 22 ← sg-orchestration&lt;br&gt;&lt;b&gt;PostgreSQL managé&lt;/b&gt; : 5432 ← sg-orchestration, sg-restitution&lt;br&gt;&lt;b&gt;Sortant&lt;/b&gt; : 443/tcp via la passerelle NAT, DNS et NTP du fournisseur" parent="1" vertex="1" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry as="geometry" x="390" y="1030" width="1150" height="175" />
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;Principes&lt;/b&gt;&lt;br&gt;{deux IP publiques en entrée : restitution (443) et depot (22 SFTP, 443)}&lt;br&gt;{9440, 8443 et le SSH d'administration jamais exposés sur Internet}&lt;br&gt;{SSH uniquement depuis orchestration (Ansible lancé par le runner)}&lt;br&gt;{secours : console série du fournisseur, pas de bastion}&lt;br&gt;{la passerelle NAT a une IP sortante, sans port entrant ; variante : NAT porté par restitution}&lt;br&gt;{UI Dagster et Grafana derrière Traefik + Keycloak}" parent="1" vertex="1" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry as="geometry" x="1580" y="260" width="300" height="260" />
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;{le magasin envoie, Vibro ne se connecte jamais au magasin}&lt;br&gt;{entrée unique : depot.&amp;lt;domaine&amp;gt; (SFTPGo)}&lt;br&gt;{une clé SSH par magasin, dépôt sous landing/&amp;lt;code_national&amp;gt;/ seulement}&lt;br&gt;{HTTPS 443 si le port 22 sortant est fermé chez le magasin}&lt;br&gt;{SFTPGo seul écrit dans vibro-landing}" parent="1" vertex="1" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry as="geometry" x="1580" y="550" width="300" height="185" />
        </mxCell>
