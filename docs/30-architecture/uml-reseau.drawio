        <mxCell id="c43" value="&lt;b&gt;Principes&lt;/b&gt;&lt;br&gt;{une seule IP publique en entrée : restitution, 443/tcp}&lt;br&gt;{9440, 9281 et 22 jamais exposés sur Internet}&lt;br&gt;{SSH uniquement depuis orchestration (Ansible lancé par le runner)}&lt;br&gt;{secours : console série du fournisseur, pas de bastion}&lt;br&gt;{la passerelle NAT a une IP sortante, sans port entrant ; variante : NAT porté par restitution}&lt;br&gt;{UI Dagster et Grafana derrière Traefik + Keycloak}" parent="1" vertex="1" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry as="geometry" x="1580" y="260" width="300" height="260" />
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;{magasins sur le logiciel de stock majoritaire : connecteur Dagster vers l'API éditeur, appel sortant}&lt;br&gt;{autres magasins : service de collecte à définir, dépôt dans landing/}" parent="1" vertex="1" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;">
